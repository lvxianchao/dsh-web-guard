{
  "name": "@lvxianchao/dsh-web-guard",
  "version": "3.0.2",
  "description": "Password login for the DeepSeek Harness Web UI, so it can be exposed on the internet: sign in from anywhere instead of chasing one-off tokens, with reverse-proxy quirks handled. Ships a native DSH settings page.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*": "./locale/*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "files": [
    "lib",
    "locale",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "cordis.patch.yml",
    "docs/logo.svg"
  ],
  "license": "MIT",
  "author": "lvxianchao",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lvxianchao/dsh-web-guard.git"
  },
  "homepage": "https://github.com/lvxianchao/dsh-web-guard#readme",
  "bugs": {
    "url": "https://github.com/lvxianchao/dsh-web-guard/issues"
  },
  "funding": [
    {
      "type": "individual",
      "url": "https://afdian.com/a/lvxianchao"
    },
    {
      "type": "individual",
      "url": "https://ko-fi.com/lvxianchao"
    }
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "auth",
    "reverse-proxy",
    "tls",
    "password",
    "login",
    "self-hosted",
    "cordis"
  ],
  "engines": {
    "node": ">=22.19",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json",
    "test:unit": "node test/unit.mjs",
    "test:e2e": "node test/e2e.mjs",
    "test": "node test/unit.mjs && node test/e2e.mjs",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "esbuild": true
  }
}
